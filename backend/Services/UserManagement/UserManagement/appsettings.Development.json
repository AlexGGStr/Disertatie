{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "your_super_secret_123456789077666",
    "Issuer": "UserManagerApi",
    "Audience": "DataApi"
  },
  "ConnectionStrings": {
    "DefaultConnection": "*"
  },
  "Kafka": {
    "BootstrapServers": "*",
    "Username": "*",
    "Password": "*",
    "GroupId": "UserConsumer",
    "Topics": {
      "User": {
        "Registered": "user.registered.v1",
        "Deleted": "user.deleted.v1"
      },
      "Property": {
        "Created": "property.created.v1",
        "Updated": "property.updated.v1"
      }
    }
  }
}
