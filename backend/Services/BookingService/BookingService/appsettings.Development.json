{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "*",
    "Username": "*",
    "Password": "*",
    "GroupId": "Booking",
    "Topics": {
      "Property": {
        "Created": "property.created.v1",
        "Updated": "property.updated.v1"
      },
      "Booking": {
        "Created": "booking.created.v1",
        "Cancelled": "booking.cancelled.v1"
      },
      "Payment": {
        "Succeeded": "payment.succeeded.v1",
        "Failed": "payment.failed.v1"
      }
    }
  },
  "MongoDb": {
    "ConnectionString": "*",
    "DatabaseName": "*"
  },
  "Jwt": {
    "Key": "*",
    "Issuer": "UserManagerApi",
    "Audience": "DataApi"
  }
}
